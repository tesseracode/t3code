+import { assert, describe, it } from "@effect/vitest";
+import type { CopilotClient } from "@github/copilot-sdk";
+import { DEFAULT_SERVER_SETTINGS, ProviderInstanceId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import * as Stream from "effect/Stream";
+import { vi } from "vite-plus/test";
+import * as ProviderHost from "@t3tools/provider-core/server/ProviderHost";
+import * as McpProviderSessions from "@t3tools/provider-core/server/McpProviderSessions";
+import { CopilotSettings } from "../settings.ts";
+import * as NativeClient from "./client.ts";
+import { CopilotDriver } from "./driver.ts";
+
+const settings = Schema.decodeSync(CopilotSettings)({});
+const host = ProviderHost.ProviderHost.of({
+  paths: {
+    cwd: "/workspace",
+    baseDir: "/test",
+    stateDir: "/test/state",
+    providerStatusCacheDir: "/test/cache",
+    attachmentsDir: "/test/attachments",
+  },
+  settings: {
+    get: Effect.succeed(DEFAULT_SERVER_SETTINGS),
+    withSnapshot: (use) => use(DEFAULT_SERVER_SETTINGS),
+    changes: Stream.empty,
+    subscribe: Effect.succeed(Stream.empty),
+  },
+  shouldRunBackgroundWork: () => Effect.succeed(false),
+  resolveAttachmentPath: () => null,
+  credentials: () =>
+    Effect.succeed({
+      binding: { owner: "t3", key: "test" },
+      get: Effect.succeedNone,
+      set: () => Effect.void,
+      remove: Effect.void,
+    }),
+});
+
+describe("Copilot workspace snapshots", () => {
+  it.effect(
+    "exposes project skills only for their requested cwd, never in the instance-wide snapshot",
+    () =>
+      Effect.gen(function* () {
+        const requested: string[] = [];
+        const fake = {
+          start: async () => {},
+          stop: async () => [],
+          forceStop: async () => {},
+          getStatus: async () => ({ version: "1.0.75", protocolVersion: 1 }),
+          getAuthStatus: async () => ({ isAuthenticated: true }),
+          listModels: async () => [],
+          createSession: async () => {
+            throw new Error("Discovery must not create native sessions.");
+          },
+          rpc: {
+            skills: {
+              discover: async ({ projectPaths }: { projectPaths: string[] }) => {
+                const cwd = projectPaths[0]!;
+                requested.push(cwd);
+                return {
+                  skills: [
+                    {
+                      name: cwd === "/project-a" ? "skill-a" : "skill-b",
+                      description: "Project skill",
+                      source: "project",
+                      enabled: true,
+                      userInvocable: true,
+                      path: `${cwd}/.github/skills/SKILL.md`,
+                    },
+                  ],
+                };
+              },
+            },
+          },
+        };
+        const mock = vi
+          .spyOn(NativeClient, "createClient")
+          .mockReturnValue(fake as unknown as CopilotClient);
+        yield* Effect.addFinalizer(() => Effect.sync(() => mock.mockRestore()));
+        const instance = yield* CopilotDriver.create({
+          instanceId: ProviderInstanceId.make("githubCopilot"),
+          displayName: undefined,
+          environment: [],
+          enabled: true,
+          config: settings,
+        });
+        const first = yield* instance.snapshotForCwd!("/project-a");
+        const second = yield* instance.snapshotForCwd!("/project-b");
+        assert.deepEqual(
+          first.skills.map((skill) => skill.name),
+          ["skill-a"],
+        );
+        assert.deepEqual(
+          second.skills.map((skill) => skill.name),
+          ["skill-b"],
+        );
+        assert.deepEqual((yield* instance.snapshot.getSnapshot).skills, []);
+        assert.deepEqual(requested, ["/project-a", "/project-b"]);
+      }).pipe(
+        Effect.provideService(ProviderHost.ProviderHost, host),
+        Effect.provide(McpProviderSessions.layer),
+        Effect.scoped,
+      ),
+  );
+});
diff --git a/packages/provider-copilot/src/server/driver.ts b/packages/provider-copilot/src/server/driver.ts
new file mode 100644
index 000000000..ad29ed011
--- /dev/null
+++ b/packages/provider-copilot/src/server/driver.ts
@@ -0,0 +1,189 @@
+import { ProviderDriverKind, type ServerProviderSkill } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import * as Option from "effect/Option";
+import * as ProviderHost from "@t3tools/provider-core/server/ProviderHost";
+import * as McpProviderSessions from "@t3tools/provider-core/server/McpProviderSessions";
+import type { ProviderDriver, ProviderInstance } from "@t3tools/provider-core/server/driver";
+import { ProviderDriverError } from "@t3tools/provider-core/server/errors";
+import { makeManagedServerProvider } from "@t3tools/provider-core/server/managedProvider";
+import { withInstanceIdentity } from "@t3tools/provider-core/server/instanceIdentity";
+import { mergeProviderInstanceEnvironment } from "@t3tools/provider-core/server/instanceEnvironment";
+import { makeManualOnlyProviderMaintenanceCapabilities } from "@t3tools/provider-core/server/maintenanceResolver";
+import {
+  haveProviderSnapshotSettingsChanged,
+  makeProviderSnapshotSettingsSource,
+} from "@t3tools/provider-core/server/snapshotSettings";
+import { CopilotSettings } from "../settings.ts";
+import { makeAdapter } from "./adapter.ts";
+import { createClient, resolveClientConfiguration } from "./client.ts";
+import { checkStatus, pendingSnapshot, skillsFromSdk } from "./status.ts";
+import { makeTextGeneration } from "./textGeneration.ts";
+
+const driverKind = ProviderDriverKind.make("githubCopilot");
+const decodeSettings = Schema.decodeSync(CopilotSettings);
+export type CopilotDriverEnv = ProviderHost.ProviderHost | McpProviderSessions.McpProviderSessions;
+
+export const CopilotDriver: ProviderDriver<CopilotSettings, CopilotDriverEnv> = {
+  driverKind,
+  metadata: { displayName: "GitHub Copilot", supportsMultipleInstances: true },
+  configSchema: CopilotSettings,
+  defaultConfig: () => decodeSettings({}),
+  create: Effect.fn("CopilotDriver.create")(function* ({
+    instanceId,
+    displayName,
+    accentColor,
+    environment,
+    enabled,
+    config,
+  }) {
+    const host = yield* ProviderHost.ProviderHost;
+    const processEnv = yield* mergeProviderInstanceEnvironment(environment);
+    const settings = { ...config, enabled };
+    const configuration = yield* Effect.try({
+      try: () =>
+        resolveClientConfiguration({ settings, cwd: host.paths.cwd, environment: processEnv }),
+      catch: (cause) =>
+        new ProviderDriverError({
+          driver: driverKind,
+          instanceId,
+          detail: "Could not configure Copilot.",
+          cause,
+        }),
+    });
+    const continuationIdentity = {
+      driverKind,
+      continuationKey: `githubCopilot:home:${configuration.effectiveHome}`,
+    };
+    const stamp = withInstanceIdentity({
+      instanceId,
+      driverKind,
+      displayName,
+      accentColor,
+      continuationGroupKey: continuationIdentity.continuationKey,
+    });
+    const workspaceSkills = new Map<string, ReadonlyArray<ServerProviderSkill>>();
+    const orchestrationAdapter = yield* makeAdapter(
+      { instanceId, settings, environment: processEnv },
+      {
+        onSkills: (cwd, skills) => {
+          if (skills) workspaceSkills.set(cwd, skills);
+          else workspaceSkills.delete(cwd);
+        },
+      },
+    );
+    const snapshotSettings = yield* makeProviderSnapshotSettingsSource(settings);
+    const snapshot = yield* makeManagedServerProvider({
+      resolveMaintenance: () =>
+        Effect.succeed(
+          makeManualOnlyProviderMaintenanceCapabilities({
+            provider: driverKind,
+            packageName: "@github/copilot-sdk",
+          }),
+        ),
+      getSettings: snapshotSettings.getSettings,
+      streamSettings: snapshotSettings.streamSettings,
+      haveSettingsChanged: haveProviderSnapshotSettingsChanged,
+      initialSnapshot: () => pendingSnapshot(settings).pipe(Effect.map(stamp)),
+      checkProvider: checkStatus(settings, host.paths.cwd, processEnv).pipe(Effect.map(stamp)),
+    }).pipe(
+      Effect.mapError(
+        (cause) =>
+          new ProviderDriverError({
+            driver: driverKind,
+            instanceId,
+            detail: "Could not build Copilot provider snapshot.",
+            cause,
+          }),
+      ),
+    );
+    const snapshotForCwd: NonNullable<ProviderInstance["snapshotForCwd"]> = Effect.fn(
+      "CopilotDriver.snapshotForCwd",
+    )(function* (cwd) {
+      const current = yield* snapshot.getSnapshot;
+      if (!enabled) return current;
+      const cached = workspaceSkills.get(cwd);
+      if (cached) return { ...current, skills: cached };
+      const skills = yield* Effect.scoped(
+        Effect.gen(function* () {
+          const client = yield* Effect.acquireRelease(
+            Effect.try({
+              try: () =>
+                createClient(
+                  resolveClientConfiguration({ settings, cwd, environment: processEnv }).options,
+                ),
+              catch: (cause) =>
+                new ProviderDriverError({
+                  driver: driverKind,
+                  instanceId,
+                  detail: "Copilot discovery failed.",
+                  cause,
+                }),
+            }),
+            (client) =>
+              Effect.gen(function* () {
+                const stopped = yield* Effect.tryPromise(() => client.stop()).pipe(
+                  Effect.timeoutOption(10_000),
+                  Effect.result,
+                );
+                if (
+                  stopped._tag === "Failure" ||
+                  Option.isNone(stopped.success) ||
+                  stopped.success.value.length
+                ) {
+                  yield* Effect.tryPromise(() => client.forceStop()).pipe(
+                    Effect.timeoutOption(5_000),
+                    Effect.ignore,
+                  );
+                }
+              }),
+          );
+          return yield* Effect.tryPromise({
+            try: async () => {
+              await client.start();
+              const discovered = await client.rpc.skills.discover({
+                projectPaths: settings.enableConfigDiscovery ? [cwd] : [],
+              });
+              return skillsFromSdk(discovered.skills);
+            },
+            catch: (cause) =>
+              new ProviderDriverError({
+                driver: driverKind,
+                instanceId,
+                detail: "Copilot workspace skill discovery failed.",
+                cause,
+              }),
+          });
+        }),
+      ).pipe(
+        Effect.timeoutOption(30_000),
+        Effect.flatMap((result) =>
+          Effect.fromOption(result).pipe(
+            Effect.mapError(
+              (cause) =>
+                new ProviderDriverError({
+                  driver: driverKind,
+                  instanceId,
+                  detail: "Copilot discovery timed out.",
+                  cause,
+                }),
+            ),
+          ),
+        ),
+      );
+      return { ...current, skills };
+    });
+    return {
+      instanceId,
+      driverKind,
+      displayName,
+      accentColor,
+      enabled,
+      continuationIdentity,
+      snapshot,
+      snapshotForCwd,
+      orchestrationAdapter,
+      textGeneration: makeTextGeneration(settings, processEnv),
+    } satisfies ProviderInstance;
+  }),
+};
diff --git a/packages/provider-copilot/src/server/status.test.ts b/packages/provider-copilot/src/server/status.test.ts
