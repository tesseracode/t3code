diff --git a/packages/provider-copilot/src/server/fusion.test.ts b/packages/provider-copilot/src/server/fusion.test.ts
new file mode 100644
index 000000000..f0d7317eb
--- /dev/null
+++ b/packages/provider-copilot/src/server/fusion.test.ts
@@ -0,0 +1,189 @@
+import { assert, describe, it } from "@effect/vitest";
+import type { SessionEvent } from "@github/copilot-sdk";
+import { normalizeFusionExecution, fusionExecutionKey, ROOT_PHASE_GAP } from "./fusion.ts";
+
+const start = "2026-10-30T00:00:00.000Z";
+const end = "2026-10-30T00:00:02.000Z";
+const receipt = "2026-10-30T00:00:04.000Z";
+function event(type: SessionEvent["type"], data: object, timestamp = end, id = type): SessionEvent {
+  return { type, data, timestamp, id, parentId: "chronological-not-semantic" } as SessionEvent;
+}
+const phase = { fusionId: "fusion-a", phaseId: "primary-1", model: "same-model", role: "primary" };
+
+describe("bounded Copilot execution metadata", () => {
+  it("keeps overlapping repeated models separate, ignores activity, and never copies drafts or usage", () => {
+    const first = event("assistant.fusion_phase_completed", {
+      ...phase,
+      durationMs: 2000,
+      status: "completed",
+      content: "PRIVATE DRAFT",
+      usage: { inputTokens: 100 },
+      verdict: "PRIVATE CRITIC",
+    });
+    const second = event("assistant.fusion_phase_completed", {
+      ...phase,
+      phaseId: "critic-2",
+      role: "critic",
+      durationMs: 2000,
+      status: "completed",
+    });
+    assert.notEqual(fusionExecutionKey(first), fusionExecutionKey(second));
+    const metadata = normalizeFusionExecution(first, "session", receipt)!;
+    assert.equal(metadata.startedAt, start);
+    assert.equal(metadata.startSource, "estimated");
+    assert.equal(metadata.durationMs, 2000);
+    assert.equal(metadata.sourceTimestamp, end);
+    assert.equal(metadata.receivedAt, receipt);
+    assert.notInclude(JSON.stringify(metadata), "PRIVATE");
+    assert.notInclude(JSON.stringify(metadata), "inputTokens");
+    assert.isUndefined(
+      normalizeFusionExecution(event("assistant.fusion_phase_activity", phase), "session", receipt),
+    );
+  });
+
+  it("retains terminal status when a delayed start arrives and upgrades estimated timing", () => {
+    const done = normalizeFusionExecution(
+      event("assistant.fusion_phase_completed", {
+        ...phase,
+        durationMs: 2000,
+        status: "completed",
+      }),
+      "session",
+      receipt,
+    )!;
+    const delayed = normalizeFusionExecution(
+      event(
+        "assistant.fusion_phase_started",
+        {
+          ...phase,
+          pattern: "cascade",
+        },
+        start,
+      ),
+      "session",
+      receipt,
+      done,
+    )!;
+    assert.equal(delayed.status, "completed");
+    assert.equal(delayed.startSource, "observed");
+    assert.equal(delayed.endedAt, end);
+    assert.deepEqual(delayed.gaps, []);
+    const replay = normalizeFusionExecution(
+      event("assistant.fusion_phase_completed", {
+        ...phase,
+        durationMs: 2000,
+        status: "completed",
+      }),
+      "session",
+      receipt,
+      delayed,
+    )!;
+    assert.equal(replay.startSource, "observed");
+    assert.equal(replay.startedAt, start);
+  });
+
+  it("records failures without provider error text and preserves unknown durations", () => {
+    const failed = normalizeFusionExecution(
+      event("assistant.fusion_phase_failed", {
+        ...phase,
+        durationMs: Number.NaN,
+        status: "failed",
+        reason: "provider-unavailable",
+        errorMessage: "PRIVATE PROVIDER RESPONSE",
+      }),
+      "session",
+      receipt,
+    )!;
+    assert.equal(failed.reason, "provider-unavailable");
+    assert.equal(failed.startSource, "unknown");
+    assert.isUndefined(failed.durationMs);
+    assert.notInclude(JSON.stringify(failed), "PRIVATE");
+  });
+
+  it("does not resurrect a phase from a late start after the root ended without terminal telemetry", () => {
+    const execution = normalizeFusionExecution(
+      event("assistant.fusion_phase_started", phase, start),
+      "session",
+      receipt,
+    )!;
+    const missing = { ...execution, status: "unknown", gaps: [ROOT_PHASE_GAP] };
+    const late = normalizeFusionExecution(
+      event("assistant.fusion_phase_started", phase, end),
+      "session",
+      receipt,
+      missing,
+    )!;
+    assert.equal(late.status, "unknown");
+    assert.equal(late.startedAt, start);
+    assert.isUndefined(late.endedAt);
+    assert.deepEqual(late.gaps, [ROOT_PHASE_GAP]);
+  });
+
+  it("separates planned models from execution and retains aggregate final source without token duplication", () => {
+    const resolved = event("session.fusion_resolved", {
+      fusionId: "fusion-a",
+      turnId: "0",
+      pattern: "critique",
+      contractVersion: 999,
+      primaryModel: "draft",
+      secondaryModel: "review",
+      fallbackModel: "fallback",
+      syntheticModel: "auto",
+      critics: [{ model: "critic", phaseId: "c1" }],
+    });
+    const plan = normalizeFusionExecution(resolved, "session", receipt)!;
+    assert.equal(plan.status, "planned");
+    assert.isUndefined(plan.model);
+    assert.equal(plan.plannedModels?.length, 3);
+    assert.include(plan.gaps[0], "Unrecognized");
+    const done = normalizeFusionExecution(
+      event("session.fusion_completed", {
+        fusionId: "fusion-a",
+        turnId: "0",
+        pattern: "critique",
+        outcome: "completed",
+        durationMs: 2000,
+        syntheticModel: "auto",
+        finalSourceModel: "draft",
+        finalSourcePhaseId: "primary-1",
+        awaitingBackgroundWork: true,
+        inputTokens: 1000,
+        totalNanoAiu: 1000,
+      }),
+      "session",
+      receipt,
+      plan,
+    )!;
+    assert.equal(done.finalSourceModel, "draft");
+    assert.isTrue(done.awaitingBackgroundWork);
+    assert.notInclude(JSON.stringify(done), "inputTokens");
+    assert.notInclude(JSON.stringify(done), "totalNanoAiu");
+    assert.equal(normalizeFusionExecution(resolved, "session", receipt, done)?.status, "completed");
+  });
+
+  it("does not derive identity or run ownership from chronological parent links", () => {
+    const failed = event("session.fusion_route_failed", {
+      attemptId: "attempt",
+      fallbackModel: "explicit",
+      policy: "opaque",
+      reason: "route-failed",
+      syntheticModel: "auto",
+      errorMessage: "PRIVATE",
+    });
+    const metadata = normalizeFusionExecution(failed, "session", receipt)!;
+    assert.isUndefined(metadata.nativeTurnId);
+    assert.isUndefined(metadata.fusionId);
+    assert.equal(metadata.fallbackModel, "explicit");
+    assert.notInclude(JSON.stringify(metadata), "chronological");
+    assert.throws(
+      () =>
+        fusionExecutionKey(
+          event("assistant.fusion_phase_started", {
+            ...phase,
+            phaseId: "x".repeat(513),
+          }),
+        ),
+      /metadata bound/,
+    );
+  });
+});
diff --git a/packages/provider-copilot/src/server/fusion.ts b/packages/provider-copilot/src/server/fusion.ts
new file mode 100644
index 000000000..da7eb6b0c
--- /dev/null
+++ b/packages/provider-copilot/src/server/fusion.ts
@@ -0,0 +1,215 @@
+import type { SessionEvent } from "@github/copilot-sdk";
+import type { OrchestrationV2ModelExecution } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+
+export const MAX_EXECUTION_ITEMS = 128;
+export const MAX_REPLAY_EXECUTION_EVENTS = 512;
+export const ROOT_PHASE_GAP = "The root turn ended without terminal phase telemetry.";
+
+const label = (value: string) => value.slice(0, 512);
+const duration = (value: number) =>
+  Number.isFinite(value) ? Math.max(0, Math.trunc(value)) : undefined;
+
+export function fusionExecutionKey(event: SessionEvent): string | undefined {
+  const identity = "fusionId" in event.data ? event.data.fusionId : undefined;
+  const phase = "phaseId" in event.data ? event.data.phaseId : undefined;
+  if (
+    (typeof identity === "string" && identity.length > 512) ||
+    (typeof phase === "string" && phase.length > 512)
+  )
+    throw new Error("Copilot execution identity exceeds the supported metadata bound.");
+  switch (event.type) {
+    case "session.fusion_resolved":
+    case "session.fusion_completed":
+      return `fusion:${event.data.fusionId}:route`;
+    case "session.fusion_route_failed":
+      return `fusion:${event.data.fusionId ?? event.data.attemptId}:route`;
+    case "assistant.fusion_phase_started":
+    case "assistant.fusion_phase_completed":
+    case "assistant.fusion_phase_failed":
+      return `fusion:${event.data.fusionId}:phase:${event.data.phaseId}`;
+    default:
+      return undefined;
+  }
+}
+
+export function normalizeFusionExecution(
+  event: SessionEvent,
+  nativeSessionId: string,
+  receivedAt: string,
+  previous?: OrchestrationV2ModelExecution,
+): OrchestrationV2ModelExecution | undefined {
+  if (!fusionExecutionKey(event)) return undefined;
+  const base: OrchestrationV2ModelExecution = {
+    version: 1,
+    kind: "route",
+    nativeSessionId,
+    eventId: event.id,
+    sourceTimestamp: event.timestamp,
+    receivedAt,
+    status: "planned",
+    startSource: "unknown",
+    gaps: [],
+  };
+  switch (event.type) {
+    case "session.fusion_resolved": {
+      const data = event.data;
+      const plannedModels = [
+        { model: label(data.primaryModel), role: "primary" },
+        ...(data.secondaryModel ? [{ model: label(data.secondaryModel), role: "secondary" }] : []),
+        ...(data.judgeModel ? [{ model: label(data.judgeModel), role: "judge" }] : []),
+        ...(data.repairModel ? [{ model: label(data.repairModel), role: "repair" }] : []),
+        ...(data.critics ?? []).slice(0, 60).map((critic) => ({
+          model: label(critic.model),
+          role: "critic",
+          phaseId: critic.phaseId,
+        })),
+      ];
+      // Replaying the route must not erase a later authoritative completion.
+      if (previous?.endedAt) return { ...previous, plannedModels };
+      return {
+        ...base,
+        fusionId: data.fusionId,
+        nativeTurnId: data.turnId,
+        syntheticModel: label(data.syntheticModel),
+        pattern: data.pattern,
+        fallbackModel: label(data.fallbackModel),
+        contractVersion: data.contractVersion,
+        plannedModels,
+        gaps: [
+          ...(data.contractVersion !== 1
+            ? ["Unrecognized routing contract version; execution facts may be incomplete."]
+            : []),
+          ...((data.critics?.length ?? 0) > 60
+            ? ["The routing plan was truncated to 64 models."]
+            : []),
+        ],
+      };
+    }
+    case "session.fusion_completed":
+      return {
+        ...(previous ?? base),
+        kind: "route",
+        fusionId: event.data.fusionId,
+        nativeTurnId: event.data.turnId,
+        eventId: event.id,
+        sourceTimestamp: event.timestamp,
+        receivedAt,
+        status: event.data.outcome,
+        pattern: event.data.pattern,
+        syntheticModel: label(event.data.syntheticModel),
+        endedAt: event.timestamp,
+        durationMs: duration(event.data.durationMs),
+        ...(event.data.finalSourceModel
+          ? { finalSourceModel: label(event.data.finalSourceModel) }
+          : {}),
+        ...(event.data.finalSourcePhaseId
+          ? { finalSourcePhaseId: event.data.finalSourcePhaseId }
+          : {}),
+        ...(event.data.degradedReason ? { reason: label(event.data.degradedReason) } : {}),
+        awaitingBackgroundWork: event.data.awaitingBackgroundWork ?? false,
+        gaps: previous?.gaps ?? ["The resolved routing plan was not observed."],
+      };
+    case "session.fusion_route_failed":
+      return {
+        ...(previous ?? base),
+        kind: "route",
+        ...(event.data.fusionId ? { fusionId: event.data.fusionId } : {}),
+        eventId: event.id,
+        sourceTimestamp: event.timestamp,
+        receivedAt,
+        status: "routing-failed",
+        reason: label(event.data.reason),
+        syntheticModel: label(event.data.syntheticModel),
+        fallbackModel: label(event.data.fallbackModel),
+        gaps: previous?.gaps ?? [
+          "Native turn association is unavailable for this routing failure.",
+        ],
+      };
+    case "assistant.fusion_phase_started": {
+      if (previous?.status === "unknown" && previous.gaps.includes(ROOT_PHASE_GAP))
+        return {
+          ...previous,
+          receivedAt,
+          startedAt: previous.startSource === "observed" ? previous.startedAt : event.timestamp,
+          startSource: "observed",
+        };
+      if (previous?.endedAt) {
+        if (Date.parse(event.timestamp) > Date.parse(previous.endedAt)) return previous;
+        return {
+          ...previous,
+          startedAt: event.timestamp,
+          startSource: "observed",
+          gaps: previous.gaps.filter(
+            (gap) => gap !== "Phase start was not observed; its start time is only an estimate.",
+          ),
+        };
+      }
+      return {
+        ...base,
+        kind: "phase",
+        fusionId: event.data.fusionId,
+        phaseId: event.data.phaseId,
+        phaseKind: event.data.phaseKind,
+        conversationScope: event.data.conversationScope,
+        model: label(event.data.model),
+        role: label(event.data.role),
+        pattern: event.data.pattern,
+        status: "running",
+        startedAt: event.timestamp,
+        startSource: "observed",
+      };
+    }
+    case "assistant.fusion_phase_completed":
+    case "assistant.fusion_phase_failed": {
+      const elapsed = duration(event.data.durationMs);
+      const observed = previous?.startSource === "observed";
+      const end = Date.parse(event.timestamp);
+      return {
+        ...(previous ?? base),
+        kind: "phase",
+        fusionId: event.data.fusionId,
+        phaseId: event.data.phaseId,
+        phaseKind: event.data.phaseKind,
+        conversationScope: event.data.conversationScope,
+        model: label(event.data.model),
+        role: label(event.data.role),
+        status: event.data.status,
+        eventId: event.id,
+        sourceTimestamp: event.timestamp,
+        receivedAt,
+        endedAt: event.timestamp,
+        durationMs: elapsed,
+        ...(event.type === "assistant.fusion_phase_completed" &&
+        event.data.endedWithBackgroundWork !== undefined
+          ? { endedWithBackgroundWork: event.data.endedWithBackgroundWork }
+          : {}),
+        ...(observed
+          ? { startedAt: previous.startedAt, startSource: "observed" as const }
+          : elapsed !== undefined && Number.isFinite(end) && end >= elapsed
+            ? {
+                startedAt: DateTime.formatIso(DateTime.makeUnsafe(end - elapsed)),
+                startSource: "estimated" as const,
+              }
+            : { startSource: "unknown" as const }),
+        ...(event.type === "assistant.fusion_phase_failed"
+          ? {
+              reason: label(event.data.reason),
+              ...(event.data.degradedToPhaseId
+                ? { degradedToPhaseId: event.data.degradedToPhaseId }
+                : {}),
+            }
+          : {}),
+        gaps: observed
+          ? []
+          : [
+              elapsed !== undefined
+                ? "Phase start was not observed; its start time is only an estimate."
+                : "Phase start and usable elapsed time were not observed.",
+            ],
+      };
+    }
+    default:
+      return undefined;
+  }
+}
