+
+  const findWorkspaceRows = SqlSchema.findAll({
+    Request: FindTwsWorkspaceByLocatorInput,
+    Result: TwsWorkspaceBindingDbRow,
+    execute: ({ environmentId, locator, includeRetired, limit }) =>
+      sql`
