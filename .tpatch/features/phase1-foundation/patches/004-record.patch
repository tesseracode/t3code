+
+  const listFeatureRows = SqlSchema.findAll({
+    Request: ListTwsFeaturesInput,
+    Result: TwsFeatureBindingDbRow,
+    execute: ({ environmentId, workspaceBindingId, includeRetired, limit }) =>
+      sql`
+        SELECT
+          feature_binding_id AS "featureBindingId",
