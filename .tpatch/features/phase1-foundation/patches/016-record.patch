+          WHERE environment_id = 'environment'
+            AND feature_binding_id = 'feature'
+            AND retired_at IS NULL
+          ORDER BY last_seen_at DESC, stack_node_binding_id ASC
+          LIMIT 100
+        `,
+      ];
+
+      for (const plan of plans) {
