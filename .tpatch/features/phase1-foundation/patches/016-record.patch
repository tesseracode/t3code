+          featureBindingId: TwsFeatureBindingId.make("feature-invalid-parent"),
+          workspaceBindingId: TwsWorkspaceBindingId.make("workspace-missing"),
+          environmentId: firstEnvironment,
+          canonicalLocator: { kind: "name", value: "invalid" },
