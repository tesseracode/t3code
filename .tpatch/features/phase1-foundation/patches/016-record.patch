+        ).toBe(0);
+        yield* Queue.offer(call.messages, { ...removed, changes: [change()] });
+        yield* Queue.offer(call.messages, delta(A, 3, [change()]));
+        const rejected = yield* h.awaitStatus(A, "error");
+        expect(aggregateAttention(rejected).itemCount).toBe(0);
+      }),
+  );
+});
