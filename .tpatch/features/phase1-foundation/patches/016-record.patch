+        )
+        VALUES (
+          ${binding.environmentId},
+          ${binding.workspaceBindingId},
+          ${binding.projectId},
+          ${binding.firstSeenAt},
+          ${binding.lastSeenAt},
+          ${binding.retiredAt}
+        )
+        ON CONFLICT (environment_id, workspace_binding_id, project_id)
+        DO UPDATE SET
+          first_seen_at = MIN(first_seen_at, excluded.first_seen_at),
