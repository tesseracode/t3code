+  );
+
+  it.effect("scopes equal feature names, filters retired rows, and deletes one subtree", () =>
+    Effect.gen(function* () {
+      const repository = yield* TwsBindingRepository;
+
+      yield* repository.upsertWorkspace({
+        workspaceBindingId: secondWorkspaceId,
