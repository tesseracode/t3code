+            reason: new RpcClientError.RpcClientDefect({ message: "Disconnected", cause: null }),
+          }),
+        );
+        yield* h.awaitStatus(A, "stale");
+        yield* TestClock.adjust("1 hour");
+        expect(yield* SubscriptionRef.get(h.remote(A).subscriptions)).toBe(1);
