+        yield* bootstrap(enabled, A);
+        yield* h.awaitStatus(A, "live");
+        yield* SubscriptionRef.set(
+          h.entries,
+          new Map([
+            [
+              A,
+              {
+                ...entryA,
+                target: new PrimaryConnectionTarget({
+                  environmentId: A,
+                  label: "Changed target",
+                  httpBaseUrl: "https://changed.test",
