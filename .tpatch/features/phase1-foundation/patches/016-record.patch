+          ${binding.environmentId},
+          ${binding.canonicalLocator.kind},
+          ${binding.canonicalLocator.value},
+          ${JSON.stringify(binding.locators)},
+          ${
+            binding.repositoryIdentity === null ? null : JSON.stringify(binding.repositoryIdentity)
+          },
+          ${binding.firstSeenAt},
+          ${binding.lastSeenAt},
+          ${binding.retiredAt}
