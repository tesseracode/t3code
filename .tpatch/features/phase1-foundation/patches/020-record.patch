@@ -0,0 +1,446 @@
+import { assert, it } from "@effect/vitest";
+import {
+  EnvironmentId,
+  EventId,
+  NodeId,
+  ProjectId,
+  ProviderDriverKind,
+  ProviderInstanceId,
+  ProviderSessionId,
